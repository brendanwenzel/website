# SSE endpoint of the Rust telemetry backend (Hetzner box behind Caddy).
# UNSET = mock mode: the hero animates with fake events on an interval and the
# ticker is labeled "simulated". Set it to go live.
# NEXT_PUBLIC_* vars are inlined at BUILD time — changing this requires a
# redeploy on Vercel.
NEXT_PUBLIC_TELEMETRY_URL=https://telemetry.brendanwenzel.com/events
